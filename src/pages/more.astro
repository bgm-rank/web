---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnimeList from "../components/sections/AnimeList.astro";
import { SeasonsSchema } from "../schemas/available-seasons";

const API_BASE = import.meta.env.API_BASE ?? "https://api.rinshankaiho.fun";
const raw: unknown = await fetch(`${API_BASE}/api/seasons`).then(
  (res) => res.json(),
);

const result = SeasonsSchema.safeParse(raw);
if (!result.success) {
  throw new Error(`API /api/seasons validation failed: ${result.error.message}`);
}

const availableSeasonIdList = result.data.map((s) => String(s.season_id));
---

<BaseLayout currentSeasonId="">
  <AnimeList availableSeasonIdList={availableSeasonIdList} />
</BaseLayout>
