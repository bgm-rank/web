---
import Downarrow from "../icons/Downarrow.astro";
import Uparrow from "../icons/Uparrow.astro";
import Clock from "../icons/Clock.astro";
import AnimeCard from "../ui/AnimeCard.astro";
import { SubjectsSchema, type Subject } from "../../schemas/season-detail";

const { season_id, updated_at } = Astro.props;

const API_BASE = import.meta.env.API_BASE ?? "https://api.rinshankaiho.fun";
const raw: unknown = await fetch(`${API_BASE}/api/seasons/${season_id}/subjects`).then(
  (res) => res.json(),
);

const result = SubjectsSchema.safeParse(raw);
if (!result.success) {
  throw new Error(`API /api/seasons/${season_id}/subjects validation failed: ${result.error.message}`);
}

const subjects = result.data;

function formatUpdatedAt(updated_at: string) {
  const date = new Date(updated_at);
  return date.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function _collection_threshold(subjects: Subject[]): number {
  const sorted = subjects
    .filter((s) => s.collection_total !== null)
    .sort((a, b) => (b.collection_total ?? 0) - (a.collection_total ?? 0));
  if (sorted.length < 4) {
    return 0;
  }
  return sorted[3].collection_total ?? 0;
}

function _comment_threshold(subjects: Subject[]): number {
  const sorted = subjects
    .filter((s) => s.average_comment !== null)
    .sort((a, b) => (b.average_comment ?? 0) - (a.average_comment ?? 0));
  if (sorted.length < 4) {
    return 0;
  }
  return sorted[3].average_comment ?? 0;
}

function _drop_rate_threshold(subjects: Subject[]): number {
  const sorted = subjects
    .filter((s) => s.drop_rate !== null)
    .sort((a, b) => (a.drop_rate ?? 1) - (b.drop_rate ?? 1));
  if (sorted.length < 4) {
    return 0;
  }
  return sorted[3].drop_rate ?? 0;
}

function _rerank(subjects: Subject[]): void {
  subjects.sort((a, b) => a.rank - b.rank);
}

const collection_threshold = _collection_threshold(subjects);
const comment_threshold = _comment_threshold(subjects);
const drop_rate_threshold = _drop_rate_threshold(subjects);
_rerank(subjects);
---

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <div class="anime-rank-header mb-4 dark:text-gray-400 flex flex-col items-end gap-2">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
      <label class="flex items-center gap-1 cursor-pointer">
        <input id="unrankedDisplayToggle" type="checkbox" class="accent-blue-600" />
        <span>无Rank</span>
      </label>
      <span class="text-gray-300 dark:text-gray-600">|</span>
      <label class="flex items-center gap-1 cursor-pointer">
        <input type="checkbox" class="media-type-cb accent-blue-600" data-value="tv" />
        <span>TV</span>
      </label>
      <label class="flex items-center gap-1 cursor-pointer">
        <input type="checkbox" class="media-type-cb accent-blue-600" data-value="ova" />
        <span>OVA</span>
      </label>
      <label class="flex items-center gap-1 cursor-pointer">
        <input type="checkbox" class="media-type-cb accent-blue-600" data-value="ona" />
        <span>ONA</span>
      </label>
      <label class="flex items-center gap-1 cursor-pointer">
        <input type="checkbox" class="media-type-cb accent-blue-600" data-value="movie" />
        <span>Movie</span>
      </label>
      <span class="text-gray-300 dark:text-gray-600">|</span>
      <label class="flex items-center gap-1 cursor-pointer">
        <input type="checkbox" class="rating-cb accent-blue-600" data-value="r18" />
        <span>NSFW</span>
      </label>
      <label class="flex items-center gap-1 cursor-pointer">
        <input type="checkbox" class="rating-cb accent-blue-600" data-value="kids" />
        <span>Kids</span>
      </label>
      <label class="flex items-center gap-1 cursor-pointer">
        <input type="checkbox" class="rating-cb accent-blue-600" data-value="general" />
        <span>General</span>
      </label>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button
        class="sort-btn text-sm px-2 py-1 border border-gray-300 dark:border-gray-600 rounded hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center gap-1 cursor-pointer transition-colors duration-200"
        data-sort-key="rank"
      >
        Rank
        <Uparrow class="icon-asc hidden text-xs" />
        <Downarrow class="icon-desc hidden text-xs" />
      </button>
      <button
        class="sort-btn text-sm px-2 py-1 border border-gray-300 dark:border-gray-600 rounded hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center gap-1 cursor-pointer transition-colors duration-200"
        data-sort-key="score"
      >
        评分
        <Uparrow class="icon-asc hidden text-xs" />
        <Downarrow class="icon-desc hidden text-xs" />
      </button>
      <button
        class="sort-btn text-sm px-2 py-1 border border-gray-300 dark:border-gray-600 rounded hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center gap-1 cursor-pointer transition-colors duration-200"
        data-sort-key="collection"
      >
        收藏
        <Uparrow class="icon-asc hidden text-xs" />
        <Downarrow class="icon-desc hidden text-xs" />
      </button>
      <button
        class="sort-btn text-sm px-2 py-1 border border-gray-300 dark:border-gray-600 rounded hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center gap-1 cursor-pointer transition-colors duration-200"
        data-sort-key="comment"
      >
        评论
        <Uparrow class="icon-asc hidden text-xs" />
        <Downarrow class="icon-desc hidden text-xs" />
      </button>
      <button
        class="sort-btn text-sm px-2 py-1 border border-gray-300 dark:border-gray-600 rounded hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center gap-1 cursor-pointer transition-colors duration-200"
        data-sort-key="drop"
      >
        抛弃率
        <Uparrow class="icon-asc hidden text-xs" />
        <Downarrow class="icon-desc hidden text-xs" />
      </button>
    </div>
  </div>
  <div id="cards-list" class="space-y-2">
    {
      subjects.map((item, index: number) => (
        <AnimeCard
          index={index}
          id={item.id}
          name={item.name}
          name_cn={item.name_cn}
          images_large={item.images_large}
          images_grid={item.images_grid}
          score={item.score}
          rank={item.rank}
          collection_total={item.collection_total}
          average_comment={item.average_comment}
          drop_rate={item.drop_rate}
          air_weekday={item.air_weekday}
          meta_tags={item.meta_tags}
          media_type={item.media_type}
          rating={item.rating}
          collection_threshold={collection_threshold}
          comment_threshold={comment_threshold}
          drop_rate_threshold={drop_rate_threshold}
        />
      ))
    }
  </div>
  <div
    class="text-gray-600 dark:text-gray-400 text-xs mt-4 mb-1 flex items-center justify-center gap-1"
  >
    <Clock class="text-xs" />
    <span>数据更新时间：{formatUpdatedAt(updated_at)}</span>
  </div>

  <style>
    #cards-list {
      counter-reset: anime-rank;
    }
  </style>

  <!-- Client script required: sort order is a runtime user preference that cannot be pre-built statically.
         Generating one page per sort key × order direction × season would produce O(N×10) pages and
         require a full rebuild on every sort interaction — SSG is not a viable alternative. -->
  <script type="module" is:inline>
    const list = document.getElementById("cards-list");
    const cards = Array.from(list.children);

    const unrankedDisplayToggle = document.getElementById("unrankedDisplayToggle");
    const headerButtons = document.querySelectorAll("[data-sort-key]");
    const mediaTypeCbs = document.querySelectorAll(".media-type-cb");
    const ratingCbs = document.querySelectorAll(".rating-cb");

    const DEFAULT_MEDIA = new Set(["tv"]);
    const DEFAULT_RATINGS = new Set(["general"]);

    const params = new URLSearchParams(location.search);
    let sortKey = params.get("sort") || "rank";
    let order = params.get("order") || "asc";
    let unrankedDisplay = params.get("unrankedDisplay") === "1";

    const mtParam = params.get("mediaTypes");
    let mediaTypes = mtParam ? new Set(mtParam.split(",")) : new Set(DEFAULT_MEDIA);

    const rtParam = params.get("ratings");
    let ratings = rtParam ? new Set(rtParam.split(",")) : new Set(DEFAULT_RATINGS);

    function sortFn(a, b) {
      const aVal = Number(a.dataset[sortKey]);
      const bVal = Number(b.dataset[sortKey]);
      const valA = isNaN(aVal) ? Infinity : aVal;
      const valB = isNaN(bVal) ? Infinity : bVal;
      return order === "asc" ? valA - valB : valB - valA;
    }

    function setsEqual(a, b) {
      if (a.size !== b.size) return false;
      for (const v of a) if (!b.has(v)) return false;
      return true;
    }

    function apply() {
      const filtered = cards.filter((c) => {
        if (!unrankedDisplay) {
          const r = Number(c.dataset.rank);
          if (Number.isNaN(r) || r >= 999999 || r <= 0) return false;
        }
        if (!mediaTypes.has(c.dataset.mediaType || "")) return false;
        if (!ratings.has(c.dataset.rating || "")) return false;
        return true;
      });
      filtered.sort(sortFn);
      list.innerHTML = "";
      filtered.forEach((el) => list.appendChild(el));

      unrankedDisplayToggle.checked = unrankedDisplay;
      mediaTypeCbs.forEach((cb) => { cb.checked = mediaTypes.has(cb.dataset.value); });
      ratingCbs.forEach((cb) => { cb.checked = ratings.has(cb.dataset.value); });

      headerButtons.forEach((btn) => {
        const active = btn.dataset.sortKey === sortKey;
        btn.classList.toggle("bg-gray-200", active);
        btn.classList.toggle("dark:bg-gray-600", active);
        const ascIcon = btn.querySelector(".icon-asc");
        const descIcon = btn.querySelector(".icon-desc");
        if (ascIcon && descIcon) {
          ascIcon.classList.toggle("hidden", !(active && order === "asc"));
          descIcon.classList.toggle("hidden", !(active && order === "desc"));
        }
      });

      const newParams = new URLSearchParams();
      if (sortKey !== "rank") newParams.set("sort", sortKey);
      if (order !== "asc") newParams.set("order", order);
      if (unrankedDisplay) newParams.set("unrankedDisplay", "1");
      if (!setsEqual(mediaTypes, DEFAULT_MEDIA)) newParams.set("mediaTypes", [...mediaTypes].join(","));
      if (!setsEqual(ratings, DEFAULT_RATINGS)) newParams.set("ratings", [...ratings].join(","));
      const search = newParams.toString();
      history.replaceState(null, "", search ? `?${search}` : location.pathname);
    }

    unrankedDisplayToggle.addEventListener("change", (e) => {
      unrankedDisplay = e.target.checked;
      apply();
    });

    mediaTypeCbs.forEach((cb) => {
      cb.addEventListener("change", () => {
        if (cb.checked) mediaTypes.add(cb.dataset.value);
        else mediaTypes.delete(cb.dataset.value);
        apply();
      });
    });

    ratingCbs.forEach((cb) => {
      cb.addEventListener("change", () => {
        if (cb.checked) ratings.add(cb.dataset.value);
        else ratings.delete(cb.dataset.value);
        apply();
      });
    });

    headerButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.dataset.sortKey;
        if (key === sortKey) {
          order = order === "asc" ? "desc" : "asc";
        } else {
          sortKey = key;
          if (key === "rank" || key === "drop") {
            order = "asc";
          } else {
            order = "desc";
          }
        }
        apply();
      });
    });

    apply();
  </script>
</div>
