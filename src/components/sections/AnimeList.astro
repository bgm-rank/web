---
function getSeasonName(seasonId: string) {
  const season_id = String(seasonId);
  const year = season_id.slice(0, 4); // 四位年份
  const season = season_id.slice(4, 6);
  return `${year}年${season}月`;
}

const { availableSeasonIdList, seasonCoverMap } = Astro.props;

const years: string[] = Array.from(
  new Set<string>(availableSeasonIdList.map((seasonId: string) => String(seasonId).slice(0, 4))),
);

const groupedSeasons = availableSeasonIdList.reduce(
  (acc: Record<string, string[]>, seasonId: string) => {
    const year = String(seasonId).slice(0, 4);
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(seasonId);
    return acc;
  },
  {},
);
---

<div class="max-w-4xl mx-auto px-1 sm:px-2 lg:px-3 py-1 sm:py-2 lg:py-3 pt-3 pb-3">
  {
    years.map((year: string) => (
      <div class="bg-white dark:bg-bgm-card rounded-lg shadow-sm border border-gray-200 dark:border-bgm-border pt-3 pb-3 px-3 py-3 mb-3">
        <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-200 mb-1 mt-0">{year}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
          {groupedSeasons[year].map((seasonId: string, index: number) => (
            <a
              href={`/${seasonId}/`}
              class="group block rounded-lg overflow-hidden transition-all duration-200 no-underline cursor-pointer transition-colors"
            >
              <div class="w-full h-40 overflow-hidden">
                <img
                  src={seasonCoverMap[seasonId] ?? ""}
                  alt={getSeasonName(seasonId)}
                  class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-110"
                />
              </div>
              <div class="p-1">
                <div class="text-sm font-medium text-gray-900 dark:text-gray-100">
                  {getSeasonName(seasonId)}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))
  }
</div>
