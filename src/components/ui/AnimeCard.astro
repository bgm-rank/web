---
import Star from "../icons/Star.astro";
import Bookmark from "../icons/Bookmark.astro";
import Chat from "../icons/Chat.astro";
import Fire from "../icons/Fire.astro";
import Keep from "../icons/Keep.astro";
import Trashbin from "../icons/Trashbin.astro";

interface Props {
  index: number;
  id: number;
  name: string | null;
  name_cn: string | null;
  images_large: string | null;
  images_grid: string | null;
  score: number | null;
  rank: number;
  collection_total: number | null;
  average_comment: number | null;
  drop_rate: number | null;
  air_weekday: string | null;
  meta_tags: string[];
  media_type: string | null;
  rating: string | null;
  collection_threshold: number;
  comment_threshold: number;
  drop_rate_threshold: number;
}

const {
  index,
  id,
  name,
  name_cn,
  images_large,
  images_grid,
  score,
  rank,
  collection_total,
  average_comment,
  drop_rate,
  air_weekday,
  meta_tags,
  media_type,
  rating,
  collection_threshold,
  comment_threshold,
  drop_rate_threshold,
} = Astro.props;
---

<div
  class="anime-card relative flex flex-col sm:flex-row items-start p-3 mb-3 bg-white dark:bg-bgm-card dark:border dark:border-bgm-border rounded-lg shadow-md overflow-hidden"
  data-rank={rank}
  data-score={score}
  data-collection={collection_total}
  data-comment={average_comment}
  data-drop={drop_rate}
  data-media-type={media_type ?? ""}
  data-rating={rating ?? ""}
>
  <!-- 排名 -->
  <div class="rank-badge top-0 left-0 w-8 h-8 absolute"></div>

  <div
    class="card-container flex flex-row items-start w-[calc(100%-1.5rem)] md:w-auto ml-6 md:ml-8 gap-3"
  >
    <!-- 动画海报 -->
    <div class="card-image flex-shrink-0 mr-3 sm:mr-4">
      <img class="w-14 sm:w-16 h-20 sm:h-24 object-cover rounded" src={images_grid ?? ""} />
    </div>
    <div class="card-body flex flex-col flex-1 min-w-0">
      <div class="card-head flex items-start gap-4">
        <!-- 标题 -->
        <div class="card-title flex-1 min-w-0 pr-2 sm:pr-20">
          <div
            class="font-bold text-base text-black dark:text-gray-100 hover:text-blue-600 dark:hover:text-blue-400 break-words"
          >
            <a href={`https://bgm.tv/subject/${id}`} target="_blank">
              {name_cn || name || "(无标题)"}
            </a>
          </div>
          <div class="text-gray-600 dark:text-gray-300 text-xs mb-1 break-words">
            {name}
          </div>
        </div>
        <!-- 评分 -->
        <div
          class="card-score flex-shrink-0 w-16 sm:w-auto ml-auto sm:text-right sm:absolute sm:right-3 sm:top-3"
        >
          <div class="font-bold text-base text-black dark:text-gray-100">
            {score === null ? "N/A" : score.toFixed(4)}
          </div>
          <div class="text-gray-600 dark:text-gray-300 text-xs mb-1">
            rank: {rank === 999999 ? "N/A" : rank}
          </div>
        </div>
      </div>
      <!-- 信息 -->
      <div class="card-info mt-2">
        <!-- 标签 -->
        <div class="flex flex-wrap gap-1 items-center">
          {
            air_weekday ? (
              <span class="bg-green-100 text-green-800 dark:bg-green-800/50 dark:text-green-200 text-xs px-1.5 py-0.5 rounded">
                {air_weekday}
              </span>
            ) : null
          }
          {
            meta_tags.map((tag: string) => (
              <span class="bg-blue-100 text-blue-800 dark:bg-blue-800/50 dark:text-blue-200 text-xs px-1.5 py-0.5 rounded">
                {tag}
              </span>
            ))
          }
        </div>
        <!-- 收藏数 -->
        <div
          class="hidden sm:flex mt-2 gap-4 text-xs text-gray-600 dark:text-gray-400 items-center"
        >
          <div class="flex flex-wrap gap-1 inline-flex items-center">
            {(collection_total ?? 0) > collection_threshold ? <Star /> : <Bookmark />}
            <span>收藏: {collection_total ?? "N/A"}</span>
          </div>
          <div class="flex flex-wrap gap-1 inline-flex items-center">
            {(average_comment ?? 0) > comment_threshold ? <Fire /> : <Chat />}
            <span>话均评论: {average_comment !== null ? average_comment.toFixed(1) : "N/A"}</span>
          </div>
          <div class="flex flex-wrap gap-1 inline-flex items-center">
            {(drop_rate ?? 1) < drop_rate_threshold ? <Keep /> : <Trashbin />}
            <span>抛弃率: {drop_rate !== null ? (drop_rate * 100).toFixed(2) + "%" : "N/A"}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- 收藏数: 移动端 -->
  <div class="sm:hidden mt-2 flex gap-4 text-xs text-gray-600 dark:text-gray-400 items-center">
    <div class="flex flex-wrap gap-1 inline-flex items-center">
      {(collection_total ?? 0) > collection_threshold ? <Star /> : <Bookmark />}
      <span>收藏: {collection_total ?? "N/A"}</span>
    </div>
    <div class="flex flex-wrap gap-1 inline-flex items-center">
      {(average_comment ?? 0) > comment_threshold ? <Fire /> : <Chat />}
      <span>话均评论: {average_comment !== null ? average_comment.toFixed(1) : "N/A"}</span>
    </div>
    <div class="flex flex-wrap gap-1 inline-flex items-center">
      {(drop_rate ?? 1) < drop_rate_threshold ? <Keep /> : <Trashbin />}
      <span>抛弃率: {drop_rate !== null ? (drop_rate * 100).toFixed(2) + "%" : "N/A"}</span>
    </div>
  </div>
</div>

<style>
  .anime-card {
    counter-increment: anime-rank;
  }

  .rank-badge {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%);
  }

  .rank-badge::before {
    content: counter(anime-rank);
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 0.875rem;
    color: rgb(55 65 81);
    background-color: rgb(243 244 246);
  }

  :global(.dark) .rank-badge::before {
    color: rgb(209 213 219);
    background-color: rgb(55 65 81);
  }
</style>
